# Required for Cursor SDK agent routing
CURSOR_API_KEY=cursor_...

# Granola REST API — for `dispatch poll-granola` / `dispatch ingest` (Business / Enterprise)
# Create in Granola → Settings → Connectors → API keys (prefix grn_)
GRANOLA_API_KEY=grn_...

# Mode Analytics MCP — also set in .cursor/mcp.json env block
MODE_WORKSPACE=
MODE_API_TOKEN=
MODE_API_SECRET=

# Optional: Asana personal access token for task sync
# Create at https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=

# Optional overrides (defaults in registry.yaml)
# ASANA_WORKSPACE_GID=
